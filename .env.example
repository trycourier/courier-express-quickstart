# Your Courier API key, from https://app.courier.com/settings/api-keys
# Copy this file to .env and fill it in. A Test key is fine.
COURIER_API_KEY=YOUR_COURIER_API_KEY

# Your app's public URL. Links in notifications are built from it.
APP_URL=http://localhost:3000

# The demo user's email. In Test, use the email you log in to Courier with:
# the Courier Test Email Provider only delivers to your workspace teammates.
DEMO_EMAIL=YOUR_EMAIL

# Optional. An E.164 number, such as +12025550156. SMS also needs an SMS
# provider such as Twilio connected in Courier. Leave it empty to skip SMS.
DEMO_PHONE=
