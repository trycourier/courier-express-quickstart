{
  "name": "courier-express-quickstart",
  "version": "1.0.0",
  "private": true,
  "description": "Send email, SMS, and in-app notifications from an Express app with Courier, and show them in a <courier-inbox>.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "first-send": "tsx --env-file=.env scripts/first-send.ts",
    "dev": "tsx watch --env-file=.env server.ts",
    "start": "tsx --env-file=.env server.ts",
    "send": "tsx --env-file=.env scripts/send.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@trycourier/courier": "^10.2.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
